# ====================================
# AutoBroker QC — Variables d'Environnement (EXEMPLE)
# ====================================
# Copier ce fichier en .env et remplir les valeurs

# --- Application ---
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://autobroker:change-me@localhost:5433/autobroker_db
USE_IN_MEMORY_DB=false
POSTGRES_PASSWORD=change-me
SEED_DEMO_DATA=false

# --- Redis ---
REDIS_URL=redis://:change-me@localhost:6379
USE_MOCK_REDIS=false
REDIS_PASSWORD=change-me

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Stripe ---
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
USE_MOCK_STRIPE=true
DEPOSIT_AMOUNT_CENTS=60000
DEPOSIT_CURRENCY=cad

# --- API Copart ---
COPART_API_URL=https://api.copart.com/v2
COPART_API_KEY=
USE_MOCK_COPART=true

# --- Import SFTP partenaire ---
SFTP_HOST=
SFTP_PORT=22
SFTP_USERNAME=
SFTP_PASSWORD=
SFTP_REMOTE_PATH=/exports/vehicles.csv

# --- Auth0 (Production) ---
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# --- Sentry ---
SENTRY_DSN=

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@autobrokerqc.ca
